# {{ ansible_managed }}

cluster.name: {{ es_cluster_name }}
node.name: {{ inventory_hostname }}
node.roles: [{{ elasticsearch_node_roles | join(', ') }}]
node.attr.zone: {{ placement.availability_zone | default('unknown') }}
cluster.routing.allocation.awareness.attributes: zone

path.data: {{ elasticsearch_data_path }}
path.logs: {{ elasticsearch_log_path }}

network.host: {{ private_ip }}
http.host: [_local_, {{ private_ip }}]
http.port: {{ es_http_port }}
transport.port: {{ es_transport_port }}

discovery.seed_hosts:
{% for host in es_hosts %}
  - {{ host }}:{{ es_transport_port }}
{% endfor %}
{% if groups['elasticsearch'] | length == 1 %}
discovery.type: single-node
{% else %}
# Ignored once the cluster has formed.
cluster.initial_master_nodes:
{% for node in elasticsearch_initial_master_nodes %}
  - {{ node }}
{% endfor %}
{% endif %}

# --- Security ------------------------------------------------------------------
xpack.security.enabled: true
xpack.security.enrollment.enabled: false

xpack.security.transport.ssl:
  enabled: true
  verification_mode: full
  key: certs/node.key
  certificate: certs/node.crt
  certificate_authorities: [certs/ca.crt]

xpack.security.http.ssl:
  enabled: true
  key: certs/node.key
  certificate: certs/node.crt
  certificate_authorities: [certs/ca.crt]
