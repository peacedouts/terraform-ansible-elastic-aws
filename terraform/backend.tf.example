# Copy to backend.tf to keep state in S3 instead of on your laptop.
# Create the bucket first (versioning on, public access blocked).

terraform {
  backend "s3" {
    bucket       = "REPLACE-with-your-state-bucket"
    key          = "elk-on-aws/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
