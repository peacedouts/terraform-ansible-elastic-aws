output "region" {
  value = var.region
}

output "vpc_id" {
  value = aws_vpc.this.id
}

output "ssm_transfer_bucket" {
  description = "S3 bucket used by Ansible's aws_ssm connection plugin."
  value       = aws_s3_bucket.ssm_transfer.bucket
}

output "instances" {
  description = "Instance IDs and private IPs by node name."
  value = {
    for name, inst in aws_instance.node :
    name => {
      id         = inst.id
      role       = local.nodes[name].role
      private_ip = inst.private_ip
    }
  }
}

output "kibana_port_forward_command" {
  description = "Run this, then open https://localhost:5601"
  value = format(
    "aws ssm start-session --region %s --target %s --document-name AWS-StartPortForwardingSession --parameters portNumber=5601,localPortNumber=5601",
    var.region,
    aws_instance.node["${var.name_prefix}-kibana-01"].id,
  )
}

# Hand Ansible what it needs without anyone copying values by hand.
# Both generated files are gitignored.

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/elk.aws_ec2.yml"
  file_permission = "0644"
  content         = <<-EOT
    ---
    # Generated by Terraform. Do not edit; rerun `terraform apply` instead.
    plugin: amazon.aws.aws_ec2
    regions:
      - ${var.region}
    filters:
      tag:ElkStack: ${var.name_prefix}
      instance-state-name: running
    hostnames:
      - tag:Name
    compose:
      ansible_host: instance_id
      private_ip: private_ip_address
      private_dns: private_dns_name
    keyed_groups:
      # Produces the groups elasticsearch, kibana and logstash.
      - key: tags.ElkRole
        prefix: ""
        separator: ""
    groups:
      elk: true
  EOT
}

resource "local_file" "ansible_vars" {
  filename        = "${path.module}/../ansible/inventory/group_vars/all/terraform.yml"
  file_permission = "0644"
  content         = <<-EOT
    ---
    # Generated by Terraform. Do not edit; rerun `terraform apply` instead.
    aws_region: "${var.region}"
    elk_stack_tag: "${var.name_prefix}"
    es_cluster_name: "${var.name_prefix}"
    ansible_aws_ssm_bucket_name: "${aws_s3_bucket.ssm_transfer.bucket}"
    ansible_aws_ssm_region: "${var.region}"
  EOT
}
